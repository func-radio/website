---
import { Image } from "astro:assets";
import funcLogo from "../assets/func.webp";
---

<header class="flex flex-col items-center gap-8 text-center">
	<Image
		src={funcLogo}
		alt="FUNC Radio Logo"
		class="size-64 rounded-lg bg-white"
	/>

	<p class="text-xl sm:text-2xl">
		FUNC Radio, a college station based out of Furman University in Greenville,
		South Carolina. Built by students, for students, we have all sorts of shows
		for all sorts of people, and definitely something you'll enjoy.
	</p>
</header>
